# 서버에서 cp .env.example .env 후 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
NODE_ENV=production
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=projectq
DB_PASSWORD=change-me
DB_NAME=projectq

# 세션 서명용 비밀값: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# HTTPS 적용 전(http 로 테스트할 때)만 false. 인증서 적용 후 true 로 바꾸세요.
COOKIE_SECURE=false

# 회원가입 시 권한: applicant(기본, 신청자) / member(멤버) / admin(관리자)
# SIGNUP_ROLE=applicant
