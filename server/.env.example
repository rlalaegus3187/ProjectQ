# 서버에서 cp .env.example .env 후 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
NODE_ENV=production
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=projectq
DB_PASSWORD=change-me
DB_NAME=projectq

# 세션 서명용 비밀값: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# HTTPS 적용 전(http 로 테스트할 때)만 false. 인증서 적용 후 true 로 바꾸세요.
COOKIE_SECURE=false

# 회원가입 시 권한: applicant(기본, 신청자) / member(멤버) / admin(관리자)
# SIGNUP_ROLE=applicant

# ---------- 한 서버에 사이트를 여러 개 돌릴 때: 사이트마다 다르게 (README '한 서버에 여러 사이트') ----------
# PORT 도 사이트마다 다르게 (3000, 3010 ...)
# CHAT_PORT=3100               # 채팅 포트 — 없거나 PORT 와 같으면 API 와 같은 포트·같은 프로세스, 다르면 따로 띄움
#                              # 바꾼 뒤 node /data/deploy.js → PM2·Nginx 함께 적용 (관리 → 사이트 설정 → 서버 포트에서 확인)
# APP_NAME=projectq              # PM2 이름 '<APP_NAME>-api', 로그 파일 이름 (영문 소문자·숫자·-·_)
# SESSION_COOKIE=projectq.sid    # 로그인 쿠키 이름 (같은 주소로 여러 사이트를 열면 겹치지 않게)
# UPLOAD_DIR=/data/uploads       # 업로드 이미지 폴더 (사이트마다 따로: /data/uploads-site2 등)

# 채팅 모듈 끄기 (server/src/chat/modules 의 이름, 쉼표로)
# CHAT_MODULES_DISABLED=dice
